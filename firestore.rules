rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Settings Collection
    match /settings/platform_config {
      allow read: if true;
      allow write: if request.resource.data.masterCode is string;
    }

    match /settings/teacher_credential {
      allow read: if true;
      allow create: if request.resource.data.pinHash is string 
                    && request.resource.data.pinHash.size() == 64;
      allow update: if request.resource.data.pinHash is string 
                    && request.resource.data.pinHash.size() == 64
                    && request.resource.data.previousPinHash == resource.data.pinHash;
    }

    match /settings/platform_analytics {
      allow read, write: if true;
    }

    // 2. Students Collection
    match /students/{studentId} {
      allow read: if true;
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.section in ['أ', 'ب', 'ج', 'د', 'مشترك أونلاين']
                    && request.resource.data.code is string;
      allow update: if true;
      allow delete: if true;
    }

    // 3. Submissions Collection
    match /submissions/{submissionId} {
      allow read: if true;

      // Allow creating submission once with valid score bounded by totalPoints
      allow create: if !exists(/databases/$(database)/documents/submissions/$(submissionId))
                    && request.resource.data.score is number
                    && request.resource.data.totalPoints is number
                    && request.resource.data.score <= request.resource.data.totalPoints
                    && request.resource.data.score >= 0;

      // Allow partial auto-grading updates upon timeout for the same student and exam
      allow update: if request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.examId == resource.data.examId
                    && request.resource.data.score is number
                    && request.resource.data.totalPoints is number
                    && request.resource.data.score <= request.resource.data.totalPoints
                    && request.resource.data.score >= 0;

      // Submissions can NEVER be deleted
      allow delete: if false;
    }

    // 4. Exams Collection
    match /exams/{examId} {
      allow read: if true;
      allow write: if request.resource.data.title is string
                    && request.resource.data.questions is list;
    }
  }
}
